---
import BaseLayout from '../layouts/BaseLayout.astro';
import { getCollection } from 'astro:content';
import { getImage } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import { CHAPTERS, catalogueNo, glyphSvg } from '../data/catalogue';

const rawProjects = (await getCollection('projects')).sort((a, b) => a.data.order - b.data.order);

function slugFrom(id: string): string {
  return id.replace(/\/index$/, '').replace(/^\//, '');
}

// Widest an image is ever shown; Astro resizes + converts to WebP at build time.
const MAX_WIDTH = 2400;

type ImgInput = ImageMetadata | { img: ImageMetadata; position?: string; fit?: 'cover' | 'contain'; caption?: string };
type ResolvedImg = { src: string; filename: string; position: string; fit: 'cover' | 'contain'; caption: string };

async function resolveImg(input: ImgInput): Promise<ResolvedImg> {
  const obj = 'img' in input ? input : { img: input };
  // At build time any property read on the image (even width) makes Astro ship the original file;
  // `clone` is the one read that doesn't, so take the width from it.
  const meta: ImageMetadata = (obj.img as ImageMetadata & { clone?: ImageMetadata }).clone ?? obj.img;
  const optimized = await getImage({
    src: obj.img,
    width: Math.min(meta.width, MAX_WIDTH),
    format: 'webp',
    quality: 80,
  });
  return {
    src: optimized.src,
    // Read the name from the optimized URL: touching obj.img.src would make Astro ship the original too.
    filename: optimized.src.split('/').pop()?.split('.')[0] ?? '',
    position: obj.position ?? 'center',
    fit: obj.fit ?? 'cover',
    caption: obj.caption ?? '',
  };
}

const resolved = await Promise.all(rawProjects.map(async p => {
  const slug = slugFrom(p.id);
  const finalRaw = p.data.images.final;
  const finalList = Array.isArray(finalRaw) ? finalRaw : [finalRaw];
  return {
    ...p,
    slug,
    resolvedImages: {
      hero: await resolveImg(p.data.images.hero),
      process: await Promise.all(p.data.images.process.map(item => resolveImg(item))),
      final: await Promise.all(finalList.map(f => resolveImg(f))),
    },
  };
}));

// Group into catalogue drawers; within a drawer, `order` decides the sequence and the number.
const drawers = CHAPTERS.map((chapter, k) => ({
  chapter,
  k,
  files: resolved
    .filter(p => p.data.chapter === chapter.key)
    .map((p, i) => ({ ...p, code: catalogueNo(chapter.key, i) })),
})).filter(d => d.files.length > 0);

// Flat catalogue order, used for indices and prev/next in the sheet view.
const projects = drawers.flatMap(d => d.files);
const years = resolved.map(p => p.data.year.match(/\d{4}/g) ?? []).flat().map(Number);
const span = `${Math.min(...years)}–${Math.max(...years)}`;
---
<BaseLayout title="Tianhui Li — Parts Catalogue">
  <div id="app">
    <!-- Overview: a drawer of files -->
    <div id="overview">
      <header class="header">
        <div class="header-top">
          <h1 class="header-name">Tianhui Li</h1>
          <p class="header-doc">Parts Catalogue &nbsp;/&nbsp; Selected Works {span}</p>
        </div>
        <p class="header-statement">Simple prototypes of form and function, combined by context, and changed by time.</p>
        <p class="header-subtitle">[context | architecture] &nbsp;·&nbsp; Each file lists a unit, the rule that combines it, and the context it answers to.</p>
      </header>

      <div class="project-list">
        {drawers.map(({ chapter, k, files }) => (
          <section class:list={['drawer', `drawer-${chapter.key}`]} style={`--k: ${k};`}>
            <span class="folder-tab"><b>{chapter.num !== '—' ? chapter.num : 'M'}</b><span>{chapter.title}</span></span>
            <p class="folder-lead">{chapter.lead}</p>
            {files.map(project => {
              const i = projects.indexOf(project);
              const hasLocation = project.data.location && project.data.location !== '—';
              const subtitle = hasLocation
                ? `${project.data.year}  ·  ${project.data.location}`
                : project.data.year;
              return (
                <a
                  href={`#${project.slug}`}
                  class="project-row"
                  data-index={i}
                  style={`animation-delay: ${0.08 + i * 0.04}s;`}
                >
                  <div
                    class="row-bg"
                    style={`background-image: url('${project.resolvedImages.hero.src}');`}
                    aria-hidden="true"
                  ></div>
                  <div class="row-body">
                    <span class="row-code">{project.code}</span>
                    <span class="row-glyph" set:html={glyphSvg(project.slug, 40)} />
                    <div class="project-info">
                      <h2 class="project-title">{project.data.title}</h2>
                      <p class="project-subtitle">{subtitle}</p>
                    </div>
                    <dl class="title-block">
                      <div><dt>Unit</dt><dd>{project.data.unit}</dd></div>
                      <div class="tb-rule"><dt>Rule</dt><dd>{project.data.rule}</dd></div>
                      <div class="tb-context"><dt>Context</dt><dd>{project.data.context}</dd></div>
                    </dl>
                  </div>
                </a>
              );
            })}
          </section>
        ))}
      </div>

      <footer class="footer">
        <span>Portfolio — Parts Catalogue</span>
        <span>About / Contact</span>
      </footer>
    </div>

    <!-- Project View Container -->
    <div id="project-view" class="project-view" aria-hidden="true">
      <div id="project-content"></div>
    </div>
  </div>

  <!-- Project data for client-side rendering -->
  <script define:vars={{ projectsData: projects.map(({ data: { images, ...data }, ...p }) => ({
    id: p.id,
    slug: p.slug,
    code: p.code,
    ...data,
    body: p.body,
    resolvedImages: p.resolvedImages,
  })) }}>
    window.__PROJECTS__ = projectsData;
  </script>
  <script src="../scripts/app.ts"></script>
</BaseLayout>

<style>
  #app {
    width: 100%;
    height: 100vh;
    overflow: hidden;
    background: #fff;
    position: relative;
    --gutter: 5.5rem;
    --gutter-r: 3rem;
    /* Each drawer's tabs sit one step further right, like a set of index dividers. */
    --tab-step: min(11rem, 14vw);
    --folder-inset: 1.2rem;
  }

  /* Overview */
  #overview {
    position: absolute;
    inset: 0;
    overflow-y: auto;
    z-index: 1;
    display: flex;
    flex-direction: column;
    min-height: 100vh;
    background: #fff;
    transition: opacity 0.25s ease, filter 0.25s ease;
  }
  #overview.dimmed {
    opacity: 0.3;
    filter: blur(1.5px);
    overflow: hidden;
  }

  /* Header */
  .header {
    padding: 2.5rem var(--gutter-r) 1.6rem var(--gutter);
    border-bottom: 1px solid #000;
    animation: fadeDown 0.5s ease both;
  }
  .header-top {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    gap: 1rem;
    flex-wrap: wrap;
  }
  .header-name {
    font-family: var(--font-sans);
    font-weight: 600;
    font-size: 1.4rem;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: #000;
  }
  .header-doc {
    font-family: var(--font-mono);
    font-size: 0.68rem;
    color: #555;
    letter-spacing: 0.04em;
  }
  .header-statement {
    font-family: var(--font-sans);
    font-weight: 400;
    font-size: 1.25rem;
    line-height: 1.45;
    color: #111;
    margin-top: 1.4rem;
    max-width: 34em;
  }
  .header-subtitle {
    font-family: var(--font-mono);
    font-size: 0.66rem;
    color: #777;
    margin-top: 0.6rem;
    letter-spacing: 0.03em;
    line-height: 1.6;
  }

  /* Project list */
  .project-list {
    flex: 1;
    padding: 3rem 0 0;
  }

  /* Folders: one per chapter, stacked like paper folders in a drawer. Each one
     overlaps the bottom of the one behind it, sits a few px off from it, is a shade
     darker, and has a small label sticking up out of its top edge, further right each time. */
  .drawer {
    --tab-x: calc(var(--gutter) - var(--folder-inset) + var(--k) * var(--tab-step));
    --folder: hsl(60 6% calc(99% - var(--k) * 1.4%));
    position: relative;
    margin-left: calc(var(--folder-inset) + var(--k) * 5px);
    margin-right: calc(var(--folder-inset) + (4 - var(--k)) * 5px);
    background: var(--folder);
    border: 1px solid #cdcdc7;
    border-radius: 2px;
    box-shadow: 0 -1px 0 rgba(255, 255, 255, 0.8), 0 -3px 10px rgba(0, 0, 0, 0.05);
    padding-bottom: 3.6rem;
    animation: fadeUp 0.4s ease both;
  }
  .drawer + .drawer {
    margin-top: -1.3rem;
  }
  .drawer:last-child {
    padding-bottom: 0.4rem;
  }

  /* The label: a small index tab sticking out of the folder, not a band */
  .folder-tab {
    position: absolute;
    bottom: 100%;
    left: var(--tab-x);
    margin-bottom: -1px; /* cover the folder edge so label and folder read as one piece of paper */
    min-width: 5.2rem;
    padding: 0.35rem 0.75rem 0.3rem;
    display: flex;
    flex-direction: column;
    gap: 0.05rem;
    background: var(--folder);
    border: 1px solid #cdcdc7;
    border-bottom: none;
    border-radius: 3px 3px 0 0;
    box-shadow: 0 -2px 5px rgba(0, 0, 0, 0.04);
    font-family: var(--font-mono);
    white-space: nowrap;
  }
  .folder-tab b {
    font-weight: 400;
    font-size: 0.78rem;
    letter-spacing: 0.04em;
    color: #222;
    line-height: 1.1;
  }
  .folder-tab span {
    font-size: 0.5rem;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: #888;
  }
  .folder-lead {
    padding: 0.8rem var(--gutter-r) 0.7rem calc(var(--tab-x) + 0.75rem);
    font-family: var(--font-mono);
    font-size: 0.62rem;
    color: #808080;
    letter-spacing: 0.02em;
  }

  /* File row: ruled lines on the folder's paper */
  .project-row {
    display: block;
    position: relative;
    border-top: 1px solid #deded8;
    text-decoration: none;
    color: inherit;
    cursor: pointer;
    background: transparent;
    transition: transform 0.35s cubic-bezier(0.22, 1, 0.36, 1), background 0.3s ease;
    animation: fadeUp 0.4s ease both;
    will-change: transform;
  }
  .project-row:last-child {
    border-bottom: 1px solid #deded8;
  }
  .project-row:hover,
  .project-row:focus-visible {
    transform: translateY(-6px);
    background: rgba(255, 255, 255, 0.7);
    z-index: 2;
    outline: none;
  }

  /* The drawing peeking out of the folder: right side only, fading into the paper */
  .row-bg {
    position: absolute;
    top: 0;
    bottom: 0;
    left: 66%;
    right: 0;
    background-size: cover;
    background-position: center;
    background-repeat: no-repeat;
    opacity: 0.55;
    filter: grayscale(1);
    -webkit-mask-image: linear-gradient(to right, transparent, #000 35%);
    mask-image: linear-gradient(to right, transparent, #000 35%);
    pointer-events: none;
    z-index: 0;
    transition: opacity 0.3s ease, filter 0.3s ease;
  }
  .project-row:hover .row-bg {
    opacity: 0.9;
    filter: grayscale(0);
  }

  /* Row body: glyph, title, and a title block of unit / rule / context */
  .row-body {
    position: relative;
    z-index: 1;
    display: grid;
    grid-template-columns: 2.6rem 40px minmax(14rem, 19rem) minmax(0, 1fr);
    align-items: center;
    gap: 1.2rem;
    padding: 0.8rem var(--gutter-r) 0.8rem 1rem;
    min-height: 4.4rem;
  }
  .row-code {
    font-family: var(--font-mono);
    font-size: 0.62rem;
    color: #888;
    letter-spacing: 0.06em;
    transition: color 0.2s;
  }
  .project-row:hover .row-code {
    color: #000;
  }
  .row-glyph {
    display: flex;
    color: #8a8a8a;
    --paper: #fff;
  }
  .drawer-misc .row-glyph {
    color: #b8b8b8;
  }
  .project-row:hover .row-glyph {
    color: #444;
  }
  .row-glyph {
    transition: color 0.2s;
  }
  .project-title {
    font-family: var(--font-sans);
    font-weight: 500;
    font-size: 1.02rem;
    line-height: 1.3;
    color: #000;
  }
  .project-subtitle {
    font-family: var(--font-mono);
    font-size: 0.62rem;
    color: #777;
    margin-top: 0.35rem;
    letter-spacing: 0.04em;
  }

  .title-block {
    display: grid;
    grid-template-columns: minmax(7rem, 0.8fr) minmax(9rem, 1.1fr) minmax(9rem, 1.1fr);
    max-width: 40rem;
    border-left: 1px solid #ddd;
  }
  .title-block > div {
    padding: 0 0.9rem;
    border-right: 1px solid #ddd;
  }
  .title-block dt {
    font-family: var(--font-mono);
    font-size: 0.52rem;
    color: #999;
    letter-spacing: 0.1em;
    text-transform: uppercase;
  }
  .title-block dd {
    font-family: var(--font-sans);
    font-size: 0.74rem;
    line-height: 1.35;
    color: #222;
    margin-top: 0.2rem;
  }

  /* Misc. drawer: archive rows, no title block */
  .drawer-misc .title-block {
    display: none;
  }
  .drawer-misc .row-body {
    min-height: 3.6rem;
  }
  .drawer-misc .project-title {
    font-size: 0.92rem;
    color: #333;
  }

  /* Footer */
  .footer {
    margin-top: 2.5rem;
    padding: 1.3rem var(--gutter-r) 1.3rem var(--gutter);
    border-top: 1px solid #000;
    display: flex;
    justify-content: space-between;
    font-family: var(--font-mono);
    font-size: 0.58rem;
    color: #888;
    letter-spacing: 0.04em;
    animation: fadeIn 0.5s ease 0.4s both;
  }

  /* Project view overlay */
  .project-view {
    position: absolute;
    left: 0;
    right: 0;
    top: 0;
    height: 100vh;
    z-index: 10;
    pointer-events: none;
    opacity: 0;
  }
  .project-view.active {
    pointer-events: auto;
  }

  /* Animations */
  @keyframes fadeDown {
    from { opacity: 0; transform: translateY(-8px); }
    to { opacity: 1; transform: translateY(0); }
  }
  @keyframes fadeUp {
    from { opacity: 0; transform: translateY(12px); }
    to { opacity: 1; transform: translateY(0); }
  }
  @keyframes fadeIn {
    from { opacity: 0; }
    to { opacity: 1; }
  }

  /* Responsive */
  @media (max-width: 1180px) {
    .title-block {
      grid-template-columns: minmax(7rem, 1fr) minmax(9rem, 1.4fr);
    }
    .tb-context {
      display: none;
    }
  }
  @media (max-width: 860px) {
    #app {
      --gutter: 1.5rem;
      --gutter-r: 1.5rem;
    }
    #app {
      --folder-inset: 0.6rem;
    }
    .drawer {
      margin-left: calc(var(--folder-inset) + var(--k) * 3px);
      margin-right: calc(var(--folder-inset) + (4 - var(--k)) * 3px);
    }
    .row-body {
      grid-template-columns: 36px minmax(0, 1fr);
      gap: 0.9rem;
      padding-left: 0.8rem;
    }
    .row-code {
      display: none;
    }
    .title-block {
      grid-column: 2;
      grid-template-columns: 1fr;
      border-left: none;
    }
    .title-block > div {
      padding: 0;
      border-right: none;
    }
    .tb-rule {
      display: none;
    }
    .title-block dt {
      display: none;
    }
    .title-block dd {
      margin-top: -0.6rem;
      font-family: var(--font-mono);
      font-size: 0.62rem;
      color: #555;
    }
    .row-bg {
      left: 45%;
    }
    .folder-lead {
      padding-left: 1rem;
    }
    .header-statement {
      font-size: 1.05rem;
    }
  }
</style>
